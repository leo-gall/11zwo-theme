{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "elfzwo/feature-panel",
	"title": "Bild-Teaser (Stichpunkte & Button)",
	"category": "elfzwo-blocks",
	"icon": "align-pull-left",
	"textdomain": "11zwo",
	"attributes": {
		"tag": {
			"type": "string",
			"default": ""
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"description": {
			"type": "string",
			"default": ""
		},
		"badge": {
			"type": "string",
			"default": ""
		},
		"badgeIcon": {
			"type": "string",
			"default": "users"
		},
		"zitat": {
			"type": "string",
			"default": ""
		},
		"ctaText": {
			"type": "string",
			"default": ""
		},
		"ctaUrl": {
			"type": "string",
			"default": ""
		},
		"imageId": {
			"type": "number",
			"default": 0
		},
		"imageUrl": {
			"type": "string",
			"default": ""
		},
		"imagePosition": {
			"type": "string",
			"default": "left"
		},
		"bulletPoints": {
			"type": "array",
			"default": [
				"Punkt 1",
				"Punkt 2"
			],
			"items": {
				"type": "string"
			}
		},
		"stil": {
			"type": "string",
			"default": ""
		},
		"image2Id": {
			"type": "number",
			"default": 0
		},
		"image2Url": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false
	},
	"render": "file:./render.php",
	"editorScript": "file:./edit.js"
}
