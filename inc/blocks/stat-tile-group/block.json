{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "elfzwo/stat-tile-group",
	"title": "Zahlen-Kacheln (Statistik-Übersicht)",
	"category": "elfzwo-blocks",
	"icon": "chart-bar",
	"textdomain": "11zwo",
	"attributes": {
		"intro": { "type": "string", "default": "" },
		"columns": { "type": "number", "default": 4 },
		"tiles": {
			"type": "array",
			"default": [
				{ "icon": "award", "value": "", "label": "" },
				{ "icon": "award", "value": "", "label": "" },
				{ "icon": "award", "value": "", "label": "" },
				{ "icon": "award", "value": "", "label": "" }
			],
			"items": {
				"type": "object",
				"properties": {
					"icon": { "type": "string" },
					"value": { "type": "string" },
					"label": { "type": "string" }
				}
			}
		}
	},
	"supports": { "html": false },
	"render": "file:./render.php",
	"editorScript": "file:./edit.js"
}
