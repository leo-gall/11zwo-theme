{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "elfzwo/termin-grid",
	"title": "Termin-Übersicht",
	"category": "elfzwo-blocks",
	"icon": "calendar-alt",
	"textdomain": "11zwo",
	"attributes": {
		"ferienHinweis": { "type": "string", "default": "" },
		"termine": {
			"type": "array",
			"default": [
				{ "zeit": "", "was": "" },
				{ "zeit": "", "was": "" }
			],
			"items": {
				"type": "object",
				"properties": {
					"zeit": { "type": "string" },
					"was": { "type": "string" },
					"downloadId": { "type": "integer" }
				}
			}
		}
	},
	"supports": { "html": false },
	"render": "file:./render.php",
	"editorScript": "file:./edit.js"
}
