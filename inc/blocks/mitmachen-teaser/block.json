{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "elfzwo/mitmachen-teaser",
	"title": "Mach mit (Aktive + Jugendfeuerwehr nebeneinander) (veraltet)",
	"category": "elfzwo-blocks",
	"icon": "groups",
	"textdomain": "11zwo",
	"attributes": {
		"titel": {
			"type": "string",
			"default": "Mach mit"
		},
		"intro": {
			"type": "string",
			"default": ""
		},
		"aktiveTitel": {
			"type": "string",
			"default": "Aktive Mannschaft"
		},
		"aktiveText": {
			"type": "string",
			"default": ""
		},
		"punkte": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"properties": {
					"title": {
						"type": "string"
					},
					"body": {
						"type": "string"
					}
				}
			}
		},
		"aktiveButtonText": {
			"type": "string",
			"default": "Mach mit!"
		},
		"aktiveButtonUrl": {
			"type": "string",
			"default": "/#mitmachen"
		},
		"jugendTitel": {
			"type": "string",
			"default": "Kinder- & Jugendfeuerwehr"
		},
		"jugendText": {
			"type": "string",
			"default": ""
		},
		"jugendPunkte": {
			"type": "array",
			"default": [],
			"items": {
				"type": "string"
			}
		},
		"jugendImageId": {
			"type": "number",
			"default": 0
		},
		"jugendImageUrl": {
			"type": "string",
			"default": ""
		},
		"jugendButtonText": {
			"type": "string",
			"default": "Alles zur Jugendfeuerwehr"
		},
		"jugendButtonUrl": {
			"type": "string",
			"default": "/jugendfeuerwehr/"
		},
		"aktiveImageId": {
			"type": "number",
			"default": 0
		},
		"aktiveImageUrl": {
			"type": "string",
			"default": ""
		},
		"aktiveImage2Id": {
			"type": "number",
			"default": 0
		},
		"aktiveImage2Url": {
			"type": "string",
			"default": ""
		},
		"teil": {
			"type": "string",
			"default": "beide"
		}
	},
	"supports": {
		"html": false,
		"inserter": false
	},
	"render": "file:./render.php",
	"editorScript": "file:./edit.js"
}