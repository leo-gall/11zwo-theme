{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "elfzwo/person-card-group",
	"title": "Ansprechpartner-Gruppe",
	"category": "elfzwo-blocks",
	"icon": "groups",
	"textdomain": "11zwo",
	"attributes": {
		"title": { "type": "string", "default": "" },
		"columns": { "type": "number", "default": 2 },
		"people": {
			"type": "array",
			"default": [
				{ "name": "", "rolle": "", "telefon": "", "email": "", "showEmail": false },
				{ "name": "", "rolle": "", "telefon": "", "email": "", "showEmail": false }
			],
			"items": {
				"type": "object",
				"properties": {
					"name": { "type": "string" },
					"rolle": { "type": "string" },
					"telefon": { "type": "string" },
					"email": { "type": "string" },
					"showEmail": { "type": "boolean" }
				}
			}
		}
	},
	"supports": { "html": false },
	"render": "file:./render.php",
	"editorScript": "file:./edit.js"
}
