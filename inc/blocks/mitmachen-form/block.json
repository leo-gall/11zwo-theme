{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "elfzwo/mitmachen-form",
	"title": "Mach-mit-Formular",
	"category": "elfzwo-blocks",
	"icon": "feedback",
	"textdomain": "11zwo",
	"attributes": {
		"title": {
			"type": "string",
			"default": "Mach mit."
		},
		"text": {
			"type": "string",
			"default": "Ohne Vorerfahrung! Hinterlass uns deine Kontaktdaten, wir melden uns bei dir."
		},
		"interests": {
			"type": "array",
			"default": [
				{ "label": "Aktive Feuerwehr" },
				{ "label": "Jugendfeuerwehr" },
				{ "label": "Fördermitglied" },
				{ "label": "Erstmal nur schnuppern" }
			]
		}
	},
	"supports": {
		"html": false
	},
	"render": "file:./render.php",
	"editorScript": "file:./edit.js"
}
